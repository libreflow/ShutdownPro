{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "ShutdownPro design tokens. Source of truth — edit here, then mirror changes into design-tokens.css (hand-authored). Single always-dark theme — no light-mode branch.",
  "primitive": {
    "color": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" },
      "ink": { "$value": "#EAF6F8", "$type": "color" },
      "cyan": {
        "200": { "$value": "#A5F3FC", "$type": "color" },
        "400": { "$value": "#22D3EE", "$type": "color" },
        "900": { "$value": "#06181C", "$type": "color" }
      },
      "amber": {
        "300": { "$value": "#FFCC66", "$type": "color" },
        "500": { "$value": "#F5A524", "$type": "color" }
      },
      "red": {
        "400": { "$value": "#FF9494", "$type": "color" },
        "500": { "$value": "#FF5A52", "$type": "color" }
      }
    },
    "alpha": {
      "cyan-400-18": { "$value": "rgba(34, 211, 238, 0.18)", "$type": "color" },
      "cyan-400-22": { "$value": "rgba(34, 211, 238, 0.22)", "$type": "color" },
      "cyan-400-35": { "$value": "rgba(34, 211, 238, 0.35)", "$type": "color" },
      "cyan-400-60": { "$value": "rgba(34, 211, 238, 0.60)", "$type": "color" },
      "amber-500-35": { "$value": "rgba(245, 165, 36, 0.35)", "$type": "color" },
      "red-500-35": { "$value": "rgba(255, 90, 82, 0.35)", "$type": "color" },

      "slate-40": { "$value": "rgba(16, 24, 28, 0.42)", "$type": "color" },
      "slate-50": { "$value": "rgba(16, 24, 28, 0.55)", "$type": "color" },
      "slate-60": { "$value": "rgba(16, 24, 28, 0.68)", "$type": "color" },
      "slate-68": { "$value": "rgba(16, 24, 28, 0.78)", "$type": "color" },
      "slate-85": { "$value": "#12171b", "$type": "color" },

      "border-10": { "$value": "rgba(148, 197, 205, 0.10)", "$type": "color" },
      "border-16": { "$value": "rgba(148, 197, 205, 0.16)", "$type": "color" },
      "border-24": { "$value": "rgba(148, 197, 205, 0.24)", "$type": "color" },
      "highlight-08": { "$value": "rgba(148, 197, 205, 0.08)", "$type": "color" }
    },
    "spacing": {
      "1": { "$value": "0.15rem", "$type": "dimension" },
      "2": { "$value": "0.2rem", "$type": "dimension" },
      "3": { "$value": "0.4rem", "$type": "dimension" },
      "4": { "$value": "0.5rem", "$type": "dimension" },
      "5": { "$value": "0.6rem", "$type": "dimension" },
      "6": { "$value": "0.9rem", "$type": "dimension" },
      "7": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" }
    },
    "fontFamily": {
      "mono": { "$value": "'Cascadia Mono', 'Cascadia Code', Consolas, ui-monospace, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs": { "$value": "0.72em", "$type": "dimension" },
      "sm": { "$value": "0.9em", "$type": "dimension" },
      "base": { "$value": "1em", "$type": "dimension" },
      "timer": { "$value": "2.5rem", "$type": "dimension" }
    },
    "fontWeight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" }
    },
    "radius": {
      "control": { "$value": "10px", "$type": "dimension" },
      "card": { "$value": "14px", "$type": "dimension" },
      "option": { "$value": "6px", "$type": "dimension" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "control": { "$value": "220ms", "$type": "duration" },
      "entrance": { "$value": "320ms", "$type": "duration" },
      "pulse": { "$value": "1.6s", "$type": "duration" }
    },
    "letterSpacing": {
      "wide": { "$value": "0.08em", "$type": "other" },
      "tight": { "$value": "-0.01em", "$type": "other" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "#0A0B0D", "$type": "color" },
      "foreground": { "$value": "{primitive.color.ink}", "$type": "color" },
      "accent": { "$value": "{primitive.color.cyan.400}", "$type": "color" },
      "accent-foreground": { "$value": "{primitive.color.cyan.200}", "$type": "color" },
      "accent-ring": { "$value": "{primitive.color.cyan.400}", "$type": "color" },
      "accent-border": { "$value": "{primitive.alpha.cyan-400-60}", "$type": "color" },
      "accent-surface": { "$value": "{primitive.alpha.cyan-400-22}", "$type": "color" },
      "accent-surface-hover": { "$value": "{primitive.alpha.cyan-400-18}", "$type": "color" },
      "accent-glow": { "$value": "{primitive.alpha.cyan-400-35}", "$type": "color" },
      "brand": { "$value": "{primitive.color.cyan.400}", "$type": "color" },
      "brand-foreground": { "$value": "{primitive.color.cyan.900}", "$type": "color" },
      "danger-foreground": { "$value": "{primitive.color.red.400}", "$type": "color" },
      "warn-foreground": { "$value": "{primitive.color.amber.300}", "$type": "color" },
      "warn-glow": { "$value": "{primitive.alpha.amber-500-35}", "$type": "color" },
      "critical-glow": { "$value": "{primitive.alpha.red-500-35}", "$type": "color" },
      "control-foreground": { "$value": "{primitive.color.white}", "$type": "color" },

      "surface": { "$value": "{primitive.alpha.slate-50}", "$type": "color" },
      "surface-subtle": { "$value": "{primitive.alpha.slate-40}", "$type": "color" },
      "surface-hover": { "$value": "{primitive.alpha.slate-60}", "$type": "color" },
      "surface-active": { "$value": "{primitive.alpha.slate-68}", "$type": "color" },
      "control-surface": { "$value": "{primitive.alpha.slate-50}", "$type": "color" },
      "popover-surface": { "$value": "{primitive.alpha.slate-85}", "$type": "color" },
      "border": { "$value": "{primitive.alpha.border-16}", "$type": "color" },
      "border-strong": { "$value": "{primitive.alpha.border-24}", "$type": "color" },
      "popover-border": { "$value": "{primitive.alpha.border-24}", "$type": "color" },
      "highlight": { "$value": "{primitive.alpha.highlight-08}", "$type": "color" }
    },
    "spacing": {
      "row-gap": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "card-gap": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "card-padding": { "$value": "{primitive.spacing.7}", "$type": "dimension" }
    },
    "motion": {
      "control": { "$value": "{primitive.duration.control}", "$type": "duration" },
      "entrance": { "$value": "{primitive.duration.entrance}", "$type": "duration" }
    }
  },
  "component": {
    "card": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.card}", "$type": "dimension" },
      "shadow": { "$value": "inset 0 1px 0 {semantic.color.highlight}", "$type": "shadow" }
    },
    "control": {
      "bg": { "$value": "{semantic.color.control-surface}", "$type": "color" },
      "bg-hover": { "$value": "{semantic.color.surface-hover}", "$type": "color" },
      "bg-active": { "$value": "{semantic.color.surface-active}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "border-hover": { "$value": "{semantic.color.border-strong}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.control}", "$type": "dimension" },
      "shadow": { "$value": "inset 0 1px 0 {semantic.color.highlight}", "$type": "shadow" }
    },
    "toggle": {
      "bg": { "$value": "{semantic.color.surface-subtle}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "shadow": { "$value": "inset 0 1px 0 {semantic.color.highlight}", "$type": "shadow" },
      "active-bg": { "$value": "{semantic.color.accent-surface}", "$type": "color" },
      "active-border": { "$value": "{semantic.color.accent-border}", "$type": "color" },
      "active-fg": { "$value": "{semantic.color.accent-foreground}", "$type": "color" },
      "active-shadow": { "$value": "0 0 0 1px {semantic.color.accent-border}, 0 0 12px {semantic.color.accent-glow}", "$type": "shadow" }
    },
    "label": {
      "font-size": { "$value": "{primitive.fontSize.xs}", "$type": "dimension" },
      "letter-spacing": { "$value": "{primitive.letterSpacing.wide}", "$type": "other" },
      "weight": { "$value": "{primitive.fontWeight.semibold}", "$type": "fontWeight" }
    },
    "button-primary": {
      "bg": { "$value": "{semantic.color.brand}", "$type": "color" },
      "fg": { "$value": "{semantic.color.brand-foreground}", "$type": "color" },
      "shadow": { "$value": "0 0 16px {semantic.color.accent-glow}", "$type": "shadow" }
    },
    "checkbox": {
      "size": { "$value": "20px", "$type": "dimension" },
      "bg": { "$value": "{component.control.bg}", "$type": "color" },
      "border": { "$value": "{component.control.border}", "$type": "color" },
      "checked-bg": { "$value": "{component.toggle.active-bg}", "$type": "color" },
      "checked-border": { "$value": "{component.toggle.active-border}", "$type": "color" },
      "check-color": { "$value": "{component.toggle.active-fg}", "$type": "color" }
    },
    "status-panel": {
      "bg": { "$value": "{semantic.color.surface-subtle}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.control}", "$type": "dimension" },
      "shadow": { "$value": "inset 0 1px 0 {semantic.color.highlight}", "$type": "shadow" },
      "shadow-warn": { "$value": "0 0 0 1px {semantic.color.warn-glow}, 0 0 14px {semantic.color.warn-glow}", "$type": "shadow" },
      "shadow-critical": { "$value": "0 0 0 1px {semantic.color.critical-glow}, 0 0 14px {semantic.color.critical-glow}", "$type": "shadow" }
    },
    "timer": {
      "font-family": { "$value": "{primitive.fontFamily.mono}", "$type": "fontFamily" },
      "font-size": { "$value": "{primitive.fontSize.timer}", "$type": "dimension" },
      "letter-spacing": { "$value": "{primitive.letterSpacing.tight}", "$type": "other" }
    },
    "popover": {
      "bg": { "$value": "{semantic.color.popover-surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.popover-border}", "$type": "color" },
      "shadow": { "$value": "0 12px 32px rgba(0, 0, 0, 0.55)", "$type": "shadow" },
      "option-radius": { "$value": "{primitive.radius.option}", "$type": "dimension" },
      "option-bg-hover": { "$value": "{semantic.color.accent-surface-hover}", "$type": "color" },
      "option-bg-selected": { "$value": "{semantic.color.accent-surface}", "$type": "color" },
      "option-fg-selected": { "$value": "{semantic.color.accent-foreground}", "$type": "color" }
    }
  }
}
